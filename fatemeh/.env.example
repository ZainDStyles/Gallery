# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env (local) or add to your host's environment settings (Vercel).
#  Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, RDS, Railway… — pick an EU/UK region)
DATABASE_URL="postgresql://user:password@host:5432/fatemeh?sslmode=require"

# Public address of the site (used in email links and SEO)
APP_URL="https://www.example.com"
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Master encryption key for photos and 2FA secrets. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep a secure backup: if it's lost, stored photos cannot be decrypted.
ENCRYPTION_KEY=""

# ── Private photo storage ────────────────────────────────────────────────────
# "local" stores encrypted files on the server's disk (dev / single server).
# "s3" for production on Vercel: a PRIVATE bucket (AWS S3 eu-west-2 London,
# Cloudflare R2, Backblaze B2…). Block all public access on the bucket.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".private-storage"
S3_BUCKET=""
S3_REGION="eu-west-2"
S3_ENDPOINT=""            # only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Email notifications (reference numbers only, never patient details) ──────
EMAIL_PROVIDER="console"  # console | resend | smtp
EMAIL_FROM="Fatemeh Hair Restoration <no-reply@example.com>"
NOTIFY_EMAIL=""           # where new-enquiry alerts go (Fatemeh)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SEND_PATIENT_CONFIRMATION="true"

# ── Data retention ───────────────────────────────────────────────────────────
# Protects the daily clean-up endpoint. openssl rand -hex 24
CRON_SECRET=""
RETENTION_MONTHS="12"          # delete enquiries after this long without activity
CONTACT_RETENTION_MONTHS="6"
AUDIT_RETENTION_MONTHS="24"

# ── Security & features ──────────────────────────────────────────────────────
REQUIRE_2FA="true"
PAYMENTS_ENABLED="false"       # deposits are recorded manually until Stripe is added
MAX_UPLOAD_MB="12"
